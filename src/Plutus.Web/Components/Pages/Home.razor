@page "/"
@inject IDbContextFactory<PlutusDbContext> DbFactory
@inject ISpendingReport SpendingReport
@inject INetWorthReport NetWorthReport
@using Plutus.Core.Reporting
@inject NavigationManager Nav
@inject ILogger<Home> Logger
@inject ISyncService SyncService
@inject TimeProvider Time
@inject Microsoft.Extensions.Options.IOptions<Plutus.Core.Sync.SyncOptions> SyncOpts
@inject Plutus.Web.Authentication.AdministratorSessionGuard SessionGuard

<PageTitle>Plutus — Dashboard</PageTitle>

@if (_loading)
{
    <div class="loading-text" style="margin-top:3rem">
        <div class="loading-spinner"></div>
        Loading…
    </div>
}
else
{
    <div class="page-header">
        <h1 class="page-title">Dashboard</h1>
        <p class="page-title-sub">@DateTime.Now.ToString("dddd, MMMM d, yyyy").ToUpper()</p>
    </div>

    <div class="card-grid dashboard-summary-grid" aria-label="Dashboard summary">
        <section class="stat-card" aria-labelledby="review-summary-heading">
            <h2 id="review-summary-heading" class="stat-label">Transactions awaiting review</h2>
            <div class="stat-value @(_needsReview > 0 ? "highlight" : "")">@_needsReview</div>
            @if (_needsReview > 0)
            {
                <a href="review" class="inline-action">Review transactions <span aria-hidden="true">→</span></a>
            }
            else
            {
                <span class="muted">No transactions currently awaiting review</span>
            }
        </section>

        <section class="stat-card" aria-labelledby="sync-summary-heading">
            <div class="stat-label stat-label-with-control">
                <h2 id="sync-summary-heading">Latest sync attempt</h2>
                @if (_hasConnection)
                {
                    <button class="sync-now-btn" disabled="@_syncing" @onclick="SyncNowAsync"
                            aria-describedby="sync-status-detail">
                        @if (_syncing)
                        {
                            <span class="btn-spinner"></span>
                            <span>Syncing</span>
                        }
                        else
                        {
                            <span aria-hidden="true">↻</span>
                            <span>Sync now</span>
                        }
                    </button>
                }
            </div>
            @if (_lastRun is null)
            {
                <div class="stat-value" style="font-size:1rem; color:var(--gray)">Never</div>
                <span id="sync-status-detail" class="muted">Connect SimpleFIN in <a href="settings" class="inline-action">Settings</a></span>
            }
            else
            {
                var ok = _lastRun.Status == SyncStatus.Success;
                <div class="stat-value sync-status" style="font-size:1rem">
                    <span class="status-dot @(ok ? "ok" : "bad")" aria-hidden="true"></span><span>@_lastRun.Status</span>
                </div>
                <span id="sync-status-detail" class="muted">@_lastRun.RanAt.ToLocalTime().ToString("MMM d · h:mm tt") · @_lastRun.NewTransactionCount new</span>
                @if (!ok)
                {
                    <a href="settings" class="inline-action sync-settings-link">View sync settings</a>
                }
            }
        </section>

        @if (_canRenderAggregates)
        {
            <section class="stat-card" aria-labelledby="net-worth-heading">
                <h2 id="net-worth-heading" class="stat-label">Net worth · @_aggregateCurrency</h2>
                @if (_netWorth is null)
                {
                    <div class="stat-value" style="font-size:1rem; color:var(--gray)">—</div>
                }
                else
                {
                    <div class="stat-value amount" style="font-size:1.4rem">@CurrencyAmountFormatter.Format(_netWorth.Total, _aggregateCurrency)</div>
                    <span class="muted">Assets @CurrencyAmountFormatter.Format(_netWorth.Assets, _aggregateCurrency) · Cards @CurrencyAmountFormatter.Format(_netWorth.Cards, _aggregateCurrency)</span>
                }
            </section>

            <section class="stat-card" aria-labelledby="top-category-heading">
                <h2 id="top-category-heading" class="stat-label">Top category · this month</h2>
                @if (_topCategory is null)
                {
                    <div class="stat-value" style="font-size:1rem; color:var(--gray)">—</div>
                    <span class="muted">No spending data yet</span>
                }
                else
                {
                    <div class="stat-value amount" style="font-size:1.4rem">@CurrencyAmountFormatter.Format(_topCategory.Total, _aggregateCurrency)</div>
                    <span class="muted">@_topCategory.Name · @($"{_topCategory.Share:P0}") of spend</span>
                }
            </section>
        }
    </div>

    @if (_canRenderAggregates)
    {
        <section aria-labelledby="spending-heading">
            <h2 id="spending-heading" class="section-label">This month · spending by category (current categorization) · @_aggregateCurrency</h2>
            <div class="card dashboard-spending-card">
                @if (_spend.Count == 0)
                {
                    <div class="empty-state">
                        <div class="empty-icon" aria-hidden="true">📊</div>
                        <p class="empty-state-title">No spending data yet</p>
                        <p>Categorized transactions will appear here once synced.</p>
                    </div>
                }
                else
                {
                    <RadzenChart SeriesClick="@OnSeriesClick" Style="@_chartStyle" aria-label="Spending by category using current categorization">
                        <RadzenBarSeries TItem="CategorySpend"
                                         Data="@_spend"
                                         CategoryProperty="Name"
                                         ValueProperty="Total"
                                         Fills="@_fills"
                                         Title="Spending">
                            <TooltipTemplate Context="data">
                                @if (data is CategorySpend row)
                                {
                                    <span>@row.Name: @CurrencyAmountFormatter.Format(row.Total, _aggregateCurrency)</span>
                                }
                            </TooltipTemplate>
                        </RadzenBarSeries>
                        <RadzenValueAxis Formatter="@FormatAsCurrency">
                            <RadzenAxisTitle Text="@($"Amount ({_aggregateCurrency})")" />
                        </RadzenValueAxis>
                        <RadzenLegend Visible="false" />
                    </RadzenChart>
                    <ul class="chart-text-fallback" aria-label="Spending by category values">
                        @foreach (var category in _spend)
                        {
                            <li>@category.Name: @CurrencyAmountFormatter.Format(category.Total, _aggregateCurrency)</li>
                        }
                    </ul>
                }
            </div>
        </section>
    }

    <section aria-labelledby="accounts-heading">
        <h2 id="accounts-heading" class="section-label">Accounts</h2>
        @if (_accounts.Count == 0)
        {
            <div class="empty-state">
                <div class="empty-icon" aria-hidden="true">🏦</div>
                <p class="empty-state-title">No accounts connected</p>
                <p><a href="settings" class="inline-action">Connect SimpleFIN in Settings</a> to start syncing.</p>
            </div>
        }
        else
        {
            @if (!_canRenderAggregates)
            {
                <p class="currency-notice">Balances are shown by currency; no total is calculated.</p>
            }
            <div class="card-grid dashboard-account-grid">
                @foreach (var account in _accounts)
                {
                    <article class="stat-card">
                        <h3 class="stat-label">@account.Name</h3>
                        <div class="stat-value amount" style="font-size:1.4rem">@CurrencyAmountFormatter.Format(account.Balance, account.Currency)</div>
                        <span class="muted">@(account.Org ?? account.Currency)</span>
                        @{
                            var stale = AccountFreshness.IsStale(account.BalanceDate, _now, _staleThreshold);
                        }
                        <span class="acct-updated @(stale ? "stale" : "")">
                            @(stale ? "⚠️ " : "")Updated @AccountFreshness.Describe(account.BalanceDate, _now)
                        </span>
                    </article>
                }
            </div>
        }
    </section>
}

@code {
    private bool _loading = true;
    private List<Account> _accounts = [];
    private int _needsReview;
    private SyncRun? _lastRun;
    private IReadOnlyList<CategorySpend> _spend = [];
    private IEnumerable<string> _fills = [];
    private string _chartStyle = "height:300px";
    private NetWorth? _netWorth;
    private TopCategory? _topCategory;
    private string? _aggregateCurrency;
    private bool _syncing;
    private bool _hasConnection;
    private DateTimeOffset _now;
    private TimeSpan _staleThreshold;

    private const string GrayFallback = "#808184";
    private bool _canRenderAggregates => _aggregateCurrency is not null;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadDataAsync();
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadDataAsync()
    {
        _now = Time.GetUtcNow();
        _staleThreshold = TimeSpan.FromHours(SyncOpts.Value.StaleAfterHours);

        await using var db = await DbFactory.CreateDbContextAsync();
        _accounts = await db.Accounts.AsNoTracking().OrderBy(a => a.Name).ToListAsync();
        _aggregateCurrency = ResolveAggregateCurrency(_accounts);
        _needsReview = await db.Transactions.CountAsync(t => !t.IsReviewed);
        _lastRun = await db.SyncRuns.AsNoTracking().OrderByDescending(r => r.RanAt).FirstOrDefaultAsync();
        _hasConnection = await db.SimpleFinConnections.AnyAsync();

        if (_canRenderAggregates)
        {
            try
            {
                var now = DateTime.Now;
                _spend = await SpendingReport.GetMonthlySpendingAsync(now.Year, now.Month);
                _fills = _spend.Select(s => s.Color ?? GrayFallback).ToList();
                _chartStyle = $"height:{_spend.Count * 44 + 60}px";
                _topCategory = SpendingInsights.Top(_spend);
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Failed to load monthly spending for the dashboard chart.");
                _spend = [];
                _fills = [];
                _topCategory = null; // keep the Top Category card consistent with the emptied chart
            }

            try
            {
                _netWorth = await NetWorthReport.GetAsync();
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Failed to load net worth for the dashboard.");
                _netWorth = null;
            }
        }
    }

    private async Task SyncNowAsync()
    {
        if (_syncing)
        {
            return;
        }

        using var lease = await SessionGuard.AcquireLeaseAsync();
        if (lease is null)
        {
            return;
        }

        _syncing = true;
        try
        {
            await SyncService.RunAsync(lease.CancellationToken);
            await LoadDataAsync();
        }
        catch (OperationCanceledException) when (lease.CancellationToken.IsCancellationRequested)
        {
            // Logout, expiry, or password rotation cancelled this active operation.
        }
        catch (Exception ex)
        {
            // RunAsync already records failures as a SyncRun; this just keeps the UI usable.
            Logger.LogError(ex, "Manual sync failed.");
        }
        finally
        {
            _syncing = false;
        }
    }

    private string FormatAsCurrency(object value)
    {
        return value switch
        {
            decimal decimalValue => CurrencyAmountFormatter.Format(decimalValue, _aggregateCurrency),
            double doubleValue => CurrencyAmountFormatter.Format((decimal)doubleValue, _aggregateCurrency),
            float floatValue => CurrencyAmountFormatter.Format((decimal)floatValue, _aggregateCurrency),
            _ => value?.ToString() ?? "",
        };
    }

    private static string? ResolveAggregateCurrency(IReadOnlyCollection<Account> accounts)
    {
        if (accounts.Count == 0)
        {
            return null;
        }

        var currency = accounts.First().Currency;
        return CurrencyAmountFormatter.IsValidIso4217Code(currency) &&
               accounts.All(account => string.Equals(account.Currency, currency, StringComparison.Ordinal))
            ? currency
            : null;
    }

    private void OnSeriesClick(SeriesClickEventArgs args)
    {
        if (args.Data is not CategorySpend row)
            return;

        var url = row.CategoryId is null
            ? "/transactions?category=uncategorized"
            : $"/transactions?category={row.CategoryId}";

        Nav.NavigateTo(url);
    }
}
